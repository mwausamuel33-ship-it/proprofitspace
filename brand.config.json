{
    "brand_name": "ProProfitSpace",
    "brand_domain": "proprofitspace.com",
    "brand_hostname": {
        "staging": "staging.proprofitspace.com/dashboard",
        "production": "proprofitspace.com/dashboard"
    },
    "domain_name": "ProProfitSpace.com",
    "colors": {
        "primary": "#00d4ff",
        "secondary": "#7c3aed",
        "tertiary": "#06b6d4",
        "success": "#00ff9d",
        "danger": "#ff3366",
        "warning": "#ffaa00",
        "info": "#00d4ff",
        "neutral": "#94a3b8",
        "black": "#0a0e1a",
        "white": "#ffffff",
        "grey": {
            "50": "#f0f9ff",
            "100": "#e0f2fe",
            "200": "#bae6fd",
            "300": "#7dd3fc",
            "400": "#38bdf8",
            "500": "#0ea5e9",
            "600": "#0284c7",
            "700": "#0369a1",
            "800": "#075985",
            "900": "#0c4a6e"
        }
    },
    "typography": {
        "font_family": {
            "primary": "Inter, system-ui, -apple-system, sans-serif",
            "secondary": "Geist, 'SF Pro Display', system-ui, sans-serif",
            "monospace": "'JetBrains Mono', 'Fira Code', 'Courier New', monospace"
        },
        "font_sizes": {
            "xs": "0.75rem",
            "sm": "0.875rem",
            "base": "1rem",
            "lg": "1.125rem",
            "xl": "1.25rem",
            "2xl": "1.5rem",
            "3xl": "1.875rem",
            "4xl": "2.25rem"
        }
    },
    "color_variants": {
        "light_variants": [100, 200, 300, 400, 500],
        "dark_variants": [600, 700, 800, 900],
        "opacity_variants": [10, 20, 30, 40, 50, 60, 70, 80, 90]
    },
    "theme_config": {
        "enable_dynamic_themes": true,
        "auto_generate_variants": true,
        "css_variable_prefix": "--brand"
    },
    "platform": {
        "name": "ProProfitSpace",
        "footer": {
            "enable_language_settings": false,
            "enable_theme_toggle": true
        },
        "hostname": {
            "production": {
                "com": "app.proprofitspace.com"
            },
            "staging": {
                "com": "staging.proprofitspace.com"
            }
        },
        "auth2_url": {
            "production": "https://auth.deriv.com/oauth2/",
            "staging": "https://staging-auth.deriv.com/oauth2/"
        },
        "derivws": {
            "url": {
                "staging": "https://staging-api.derivws.com/trading/v1/",
                "production": "https://api.derivws.com/trading/v1/"
            },
            "directories": {
                "options": "options/",
                "derivatives": "derivatives/"
            }
        }
    }
}
