<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
<variables>
<variable id="v_stake">stake</variable>
<variable id="v_take_profit">take_profit</variable>
<variable id="v_stop_loss">stop_loss</variable>
<variable id="v_max_consecutive_losses">max_consecutive_losses</variable>
<variable id="v_consecutive_losses">consecutive_losses</variable>
<variable id="v_prediction">prediction_barrier</variable>
</variables>
<block type="trade_definition" id="blk_tradedef" deletable="false" x="0" y="0">
<statement name="TRADE_OPTIONS">
<block type="trade_definition_market" id="blk_market" deletable="false" movable="false">
<field name="MARKET_LIST">synthetic_index</field>
<field name="SUBMARKET_LIST">random_index</field>
<field name="SYMBOL_LIST">R_10</field>
<next>
<block type="trade_definition_tradetype" id="blk_tradetype" deletable="false" movable="false">
<field name="TRADETYPECAT_LIST">digits</field>
<field name="TRADETYPE_LIST">overunder</field>
<next>
<block type="trade_definition_contracttype" id="blk_contracttype" deletable="false" movable="false">
<field name="TYPE_LIST">both</field>
<next>
<block type="trade_definition_candleinterval" id="blk_candleinterval" deletable="false" movable="false">
<field name="CANDLEINTERVAL_LIST">60</field>
<next>
<block type="trade_definition_restartbuysell" id="blk_restartbuysell" deletable="false" movable="false">
<field name="TIME_MACHINE_ENABLED">FALSE</field>
<next>
<block type="trade_definition_restartonerror" id="blk_restartonerror" deletable="false" movable="false">
<field name="RESTARTONERROR">TRUE</field>
</block>
</next>
</block>
</next>
</block>
</next>
</block>
</next>
</block>
</next>
</block>
</statement>
<statement name="INITIALIZATION">
<block type="variables_set" id="blk_init_stake">
<field name="VAR" id="v_stake" variabletype="">stake</field>
<value name="VALUE">
<block type="math_number" id="blk_num_stake">
<field name="NUM">1</field>
</block>
</value>
<next>
<block type="variables_set" id="blk_init_tp">
<field name="VAR" id="v_take_profit" variabletype="">take_profit</field>
<value name="VALUE">
<block type="math_number" id="blk_num_tp">
<field name="NUM">10</field>
</block>
</value>
<next>
<block type="variables_set" id="blk_init_sl">
<field name="VAR" id="v_stop_loss" variabletype="">stop_loss</field>
<value name="VALUE">
<block type="math_number" id="blk_num_sl">
<field name="NUM">10</field>
</block>
</value>
<next>
<block type="variables_set" id="blk_init_maxcl">
<field name="VAR" id="v_max_consecutive_losses" variabletype="">max_consecutive_losses</field>
<value name="VALUE">
<block type="math_number" id="blk_num_maxcl">
<field name="NUM">3</field>
</block>
</value>
<next>
<block type="variables_set" id="blk_init_cl">
<field name="VAR" id="v_consecutive_losses" variabletype="">consecutive_losses</field>
<value name="VALUE">
<block type="math_number" id="blk_num_cl">
<field name="NUM">0</field>
</block>
</value>
<next>
<block type="variables_set" id="blk_init_pred">
<field name="VAR" id="v_prediction" variabletype="">prediction_barrier</field>
<value name="VALUE">
<block type="math_number" id="blk_num_pred">
<field name="NUM">0</field>
</block>
</value>
</block>
</next>
</block>
</next>
</block>
</next>
</block>
</next>
</block>
</next>
</block>
</statement>
<statement name="SUBMARKET">
<block type="controls_if" id="blk_if_toggle">
<mutation else="1"></mutation>
<value name="IF0">
<block type="logic_compare" id="blk_cmp_toggle">
<field name="OP">EQ</field>
<value name="A">
<block type="variables_get" id="blk_get_pred_check">
<field name="VAR" id="v_prediction" variabletype="">prediction_barrier</field>
</block>
</value>
<value name="B">
<block type="math_number" id="blk_num_zero_check">
<field name="NUM">0</field>
</block>
</value>
</block>
</value>
<statement name="DO0">
<block type="variables_set" id="blk_set_pred_1">
<field name="VAR" id="v_prediction" variabletype="">prediction_barrier</field>
<value name="VALUE">
<block type="math_number" id="blk_num_one">
<field name="NUM">1</field>
</block>
</value>
</block>
</statement>
<statement name="ELSE">
<block type="variables_set" id="blk_set_pred_0">
<field name="VAR" id="v_prediction" variabletype="">prediction_barrier</field>
<value name="VALUE">
<block type="math_number" id="blk_num_zero">
<field name="NUM">0</field>
</block>
</value>
</block>
</statement>
</block>
</statement>
<next>
<block type="trade_definition_tradeoptions" id="blk_tradeoptions">
<mutation xmlns="http://www.w3.org/1999/xhtml" has_first_barrier="false" has_second_barrier="false" has_prediction="true"></mutation>
<field name="DURATIONTYPE_LIST">t</field>
<value name="DURATION">
<shadow type="math_number_positive" id="shadow_duration">
<field name="NUM">1</field>
</shadow>
</value>
<value name="AMOUNT">
<shadow type="math_number_positive" id="shadow_amount">
<field name="NUM">1</field>
</shadow>
<block type="variables_get" id="blk_get_stake_amount">
<field name="VAR" id="v_stake" variabletype="">stake</field>
</block>
</value>
<value name="PREDICTION">
<shadow type="math_number_positive" id="shadow_prediction" inline="true">
<field name="NUM">1</field>
</shadow>
<block type="variables_get" id="blk_get_prediction">
<field name="VAR" id="v_prediction" variabletype="">prediction_barrier</field>
</block>
</value>
</block>
</next>
</block>
<block type="before_purchase" id="blk_beforepurchase" deletable="false" x="0" y="900">
<statement name="BEFOREPURCHASE_STACK">
<block type="controls_if" id="blk_if_circuitbreaker">
<value name="IF0">
<block type="logic_compare" id="blk_cmp_cl">
<field name="OP">LT</field>
<value name="A">
<block type="variables_get" id="blk_get_cl_check">
<field name="VAR" id="v_consecutive_losses" variabletype="">consecutive_losses</field>
</block>
</value>
<value name="B">
<block type="variables_get" id="blk_get_maxcl_check">
<field name="VAR" id="v_max_consecutive_losses" variabletype="">max_consecutive_losses</field>
</block>
</value>
</block>
</value>
<statement name="DO0">
<block type="purchase" id="blk_purchase">
<field name="PURCHASE_LIST">DIGITOVER</field>
</block>
</statement>
</block>
</statement>
</block>
<block type="during_purchase" id="blk_duringpurchase" x="500" y="0">
<statement name="DURING_PURCHASE_STACK">
<block type="controls_if" id="blk_if_sell">
<value name="IF0">
<block type="check_sell" id="blk_checksell"></block>
</value>
</block>
</statement>
</block>
<block type="after_purchase" id="blk_afterpurchase" x="500" y="900">
<statement name="AFTERPURCHASE_STACK">
<block type="controls_if" id="blk_if_result">
<mutation else="1"></mutation>
<value name="IF0">
<block type="contract_check_result" id="blk_checkresult">
<field name="CHECK_RESULT">win</field>
</block>
</value>
<statement name="DO0">
<block type="variables_set" id="blk_reset_cl">
<field name="VAR" id="v_consecutive_losses" variabletype="">consecutive_losses</field>
<value name="VALUE">
<block type="math_number" id="blk_num_reset_cl">
<field name="NUM">0</field>
</block>
</value>
</block>
</statement>
<statement name="ELSE">
<block type="variables_set" id="blk_incr_cl">
<field name="VAR" id="v_consecutive_losses" variabletype="">consecutive_losses</field>
<value name="VALUE">
<block type="math_arithmetic" id="blk_add_cl">
<field name="OP">ADD</field>
<value name="A">
<shadow type="math_number" id="shadow_add_a">
<field name="NUM">1</field>
</shadow>
<block type="variables_get" id="blk_get_cl_add">
<field name="VAR" id="v_consecutive_losses" variabletype="">consecutive_losses</field>
</block>
</value>
<value name="B">
<shadow type="math_number" id="shadow_add_b">
<field name="NUM">1</field>
</shadow>
</value>
</block>
</value>
</block>
</statement>
<next>
<block type="controls_if" id="blk_if_tpsl">
<value name="IF0">
<block type="logic_operation" id="blk_and_tpsl">
<field name="OP">AND</field>
<value name="A">
<block type="logic_compare" id="blk_cmp_tp">
<field name="OP">LT</field>
<value name="A">
<block type="total_profit" id="blk_totalprofit_tp"></block>
</value>
<value name="B">
<block type="variables_get" id="blk_get_tp">
<field name="VAR" id="v_take_profit" variabletype="">take_profit</field>
</block>
</value>
</block>
</value>
<value name="B">
<block type="logic_compare" id="blk_cmp_sl">
<field name="OP">GT</field>
<value name="A">
<block type="total_profit" id="blk_totalprofit_sl"></block>
</value>
<value name="B">
<block type="math_arithmetic" id="blk_neg_sl">
<field name="OP">MINUS</field>
<value name="A">
<shadow type="math_number" id="shadow_zero">
<field name="NUM">0</field>
</shadow>
</value>
<value name="B">
<shadow type="math_number" id="shadow_sl_placeholder">
<field name="NUM">10</field>
</shadow>
<block type="variables_get" id="blk_get_sl">
<field name="VAR" id="v_stop_loss" variabletype="">stop_loss</field>
</block>
</value>
</block>
</value>
</block>
</value>
</block>
</value>
<statement name="DO0">
<block type="trade_again" id="blk_tradeagain"></block>
</statement>
</block>
</next>
</block>
</statement>
</block>
</xml>
