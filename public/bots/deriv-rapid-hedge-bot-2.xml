<xml xmlns="http://www.w3.org/1999/xhtml" collection="false">
  <!-- Block 1: Run Once At Start -->
  <block type="trade_definition" id="trade_def_1" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="market" id="market_setup">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">R_100</field>
        <next>
          <block type="trade_type" id="trade_type_setup">
            <field name="TRADETYPE_LIST">risefall</field>
            <next>
              <block type="contract_type" id="contract_setup">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="candle_interval" id="candle_setup">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="duration" id="duration_setup">
                        <field name="DURATION_LIST">t</field>
                        <value name="DURATION">
                          <shadow type="math_number" id="dur_val">
                            <field name="NUM">5</field>
                          </shadow>
                        </value>
                        <next>
                          <block type="amount" id="amount_setup">
                            <value name="AMOUNT">
                              <shadow type="math_number" id="amt_val">
                                <field name="NUM">1</field>
                              </shadow>
                            </value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <!-- Block 2: Purchase Conditions -->
  <block type="before_purchase" id="before_pur_1" x="0" y="400">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if" id="toggle_logic">
        <mutation else="1"></mutation>
        <value name="IF0">
          <block type="logic_compare" id="check_higher">
            <field name="OP">EQ</field>
            <value name="A">
              <block type="variables_get" id="get_dir">
                <field name="VAR">trade_direction</field>
              </block>
            </value>
            <value name="B">
              <block type="logic_boolean" id="bool_true">
                <field name="BOOL">TRUE</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="variables_set" id="set_false">
            <field name="VAR">trade_direction</field>
            <value name="VALUE">
              <block type="logic_boolean" id="bool_false">
                <field name="BOOL">FALSE</field>
              </block>
            </value>
            <next>
              <block type="purchase" id="pur_higher">
                <field name="PURCHASE_LIST">CALL</field>
              </block>
            </next>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="variables_set" id="set_true">
            <field name="VAR">trade_direction</field>
            <value name="VALUE">
              <block type="logic_boolean" id="bool_true_reset">
                <field name="BOOL">TRUE</field>
              </block>
            </value>
            <next>
              <block type="purchase" id="pur_lower">
                <field name="PURCHASE_LIST">PUT</field>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </statement>
  </block>

  <!-- Block 3: After Purchase Loop -->
  <block type="after_purchase" id="after_pur_1" x="0" y="700">
    <statement name="AFTERPURCHASE_STACK">
      <block type="trade_again" id="loop_again"></block>
    </statement>
  </block>
</xml>
