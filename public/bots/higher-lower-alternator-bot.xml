<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="http://www.w3.org/1999/xhtml" collection="false">
  <!--
    HIGHER / LOWER ALTERNATOR
    Market      : Volatility 100 Index (R_100)
    Trade type  : Rise/Fall (Up/Down), both directions enabled
    Duration    : 5 ticks
    Stake       : 1 USD
    Logic       : Buys HIGHER (Rise/CALL) on cycle 1. The moment that contract
                  settles, it immediately buys LOWER (Fall/PUT) on cycle 2, then
                  keeps alternating HIGHER / LOWER for every trade.
    Note        : Deriv Bot holds one open contract per strategy cycle, so the
                  opposite direction is entered on the very next cycle without
                  any waiting, pause or extra condition.
  -->
  <variables>
    <variable id="next_direction_var">next_direction</variable>
  </variables>

  <block type="trade_definition" id="trade_definition_block" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="market_block">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">R_100</field>
        <next>
          <block type="trade_definition_tradetype" id="tradetype_block">
            <field name="TRADETYPECAT_LIST">callput</field>
            <field name="TRADETYPE_LIST">callput</field>
            <next>
              <block type="trade_definition_contracttype" id="contracttype_block">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="candleinterval_block">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="restartbuysell_block">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="restartonerror_block">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="init_next_direction">
        <field name="VAR" id="next_direction_var">next_direction</field>
        <value name="VALUE">
          <block type="text" id="init_next_direction_value">
            <field name="TEXT">HIGHER</field>
          </block>
        </value>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="tradeoptions_block">
        <mutation has_first_barrier="false" has_second_barrier="false" has_prediction="false"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION">
          <shadow type="math_number" id="duration_shadow">
            <field name="NUM">5</field>
          </shadow>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number" id="amount_shadow">
            <field name="NUM">1</field>
          </shadow>
        </value>
      </block>
    </statement>
  </block>

  <block type="before_purchase" id="before_purchase_block" x="0" y="560">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if" id="pick_direction">
        <mutation else="1"></mutation>
        <value name="IF0">
          <block type="logic_compare" id="is_higher">
            <field name="OP">EQ</field>
            <value name="A">
              <block type="variables_get" id="read_next_direction">
                <field name="VAR" id="next_direction_var">next_direction</field>
              </block>
            </value>
            <value name="B">
              <block type="text" id="higher_literal">
                <field name="TEXT">HIGHER</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="purchase" id="purchase_higher">
            <field name="PURCHASE_LIST">CALL</field>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="purchase" id="purchase_lower">
            <field name="PURCHASE_LIST">PUT</field>
          </block>
        </statement>
      </block>
    </statement>
  </block>

  <block type="after_purchase" id="after_purchase_block" x="0" y="860">
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="flip_direction">
        <mutation else="1"></mutation>
        <value name="IF0">
          <block type="logic_compare" id="was_higher">
            <field name="OP">EQ</field>
            <value name="A">
              <block type="variables_get" id="read_next_direction_after">
                <field name="VAR" id="next_direction_var">next_direction</field>
              </block>
            </value>
            <value name="B">
              <block type="text" id="higher_literal_after">
                <field name="TEXT">HIGHER</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="variables_set" id="set_lower">
            <field name="VAR" id="next_direction_var">next_direction</field>
            <value name="VALUE">
              <block type="text" id="lower_literal">
                <field name="TEXT">LOWER</field>
              </block>
            </value>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="variables_set" id="set_higher">
            <field name="VAR" id="next_direction_var">next_direction</field>
            <value name="VALUE">
              <block type="text" id="higher_literal_reset">
                <field name="TEXT">HIGHER</field>
              </block>
            </value>
          </block>
        </statement>
        <next>
          <block type="trade_again" id="trade_again_block"></block>
        </next>
      </block>
    </statement>
  </block>
</xml>
