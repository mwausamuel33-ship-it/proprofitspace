<xml xmlns="http://www.w3.org/1999/xhtml" is_dbot="true" collection="false">
  <variables>
    <variable id="var_stake">stake</variable>
    <variable id="var_initial">initial_stake</variable>
    <variable id="var_mult">recovery_multiplier</variable>
    <variable id="var_tp">take_profit</variable>
    <variable id="var_sl">stop_loss</variable>
    <variable id="var_offset">barrier_offset</variable>
  </variables>

  <block type="trade_definition" id="td_lower" deletable="false" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="mkt_l" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">R_100</field>
        <next>
          <block type="trade_definition_tradetype" id="tt_l" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">callput</field>
            <field name="TRADETYPE_LIST">higherlower</field>
            <next>
              <block type="trade_definition_contracttype" id="ct_l" deletable="false" movable="false">
                <field name="TYPE_LIST">PUT</field>
                <next>
                  <block type="trade_definition_candleinterval" id="ci_l" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="rb_l" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="re_l" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>

    <statement name="INITIALIZATION">
      <block type="variables_set" id="init_l1">
        <field name="VAR" id="var_initial">initial_stake</field>
        <value name="VALUE">
          <block type="math_number" id="n_l1"><field name="NUM">1</field></block>
        </value>
        <next>
          <block type="variables_set" id="init_l2">
            <field name="VAR" id="var_stake">stake</field>
            <value name="VALUE">
              <block type="variables_get" id="g_l1"><field name="VAR" id="var_initial">initial_stake</field></block>
            </value>
            <next>
              <block type="variables_set" id="init_l3">
                <field name="VAR" id="var_mult">recovery_multiplier</field>
                <value name="VALUE">
                  <block type="math_number" id="n_l2"><field name="NUM">1</field></block>
                </value>
                <next>
                  <block type="variables_set" id="init_l4">
                    <field name="VAR" id="var_offset">barrier_offset</field>
                    <value name="VALUE">
                      <block type="math_number" id="n_l3"><field name="NUM">1</field></block>
                    </value>
                    <next>
                      <block type="variables_set" id="init_l5">
                        <field name="VAR" id="var_tp">take_profit</field>
                        <value name="VALUE">
                          <block type="math_number" id="n_l4"><field name="NUM">10</field></block>
                        </value>
                        <next>
                          <block type="variables_set" id="init_l6">
                            <field name="VAR" id="var_sl">stop_loss</field>
                            <value name="VALUE">
                              <block type="math_number" id="n_l5"><field name="NUM">10</field></block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>

    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="opts_l">
        <mutation xmlns="http://www.w3.org/1999/xhtml" has_first_barrier="true" has_second_barrier="false" has_prediction="false"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <field name="BARRIEROFFSETTYPE_LIST">+</field>
        <field name="CURRENCY_LIST">USD</field>
        <value name="DURATION">
          <shadow type="math_number" id="d_l"><field name="NUM">5</field></shadow>
        </value>
        <value name="BARRIEROFFSET">
          <shadow type="math_number" id="bo_l"><field name="NUM">1</field></shadow>
          <block type="variables_get" id="g_l2"><field name="VAR" id="var_offset">barrier_offset</field></block>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number" id="a_l"><field name="NUM">1</field></shadow>
          <block type="variables_get" id="g_l3"><field name="VAR" id="var_stake">stake</field></block>
        </value>
      </block>
    </statement>
  </block>

  <block type="before_purchase" id="bp_l" deletable="false" x="0" y="480">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="purchase" id="buy_l">
        <field name="PURCHASE_LIST">PUT</field>
      </block>
    </statement>
  </block>

  <block type="after_purchase" id="ap_l" deletable="false" x="0" y="620">
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="if_l1">
        <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
        <value name="IF0">
          <block type="logic_operation" id="or_l">
            <field name="OP">OR</field>
            <value name="A">
              <block type="logic_compare" id="cmp_l1">
                <field name="OP">GTE</field>
                <value name="A">
                  <block type="total_profit" id="tp_l1"></block>
                </value>
                <value name="B">
                  <block type="variables_get" id="g_l4"><field name="VAR" id="var_tp">take_profit</field></block>
                </value>
              </block>
            </value>
            <value name="B">
              <block type="logic_compare" id="cmp_l2">
                <field name="OP">LTE</field>
                <value name="A">
                  <block type="total_profit" id="tp_l2"></block>
                </value>
                <value name="B">
                  <block type="math_single" id="neg_l">
                    <field name="OP">NEG</field>
                    <value name="NUM">
                      <shadow type="math_number"><field name="NUM">1</field></shadow>
                      <block type="variables_get" id="g_l5"><field name="VAR" id="var_sl">stop_loss</field></block>
                    </value>
                  </block>
                </value>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="notify" id="nt_l">
            <field name="NOTIFICATION_TYPE">success</field>
            <value name="MESSAGE">
              <shadow type="text"><field name="TEXT">LOWER leg stopped: TP or SL reached</field></shadow>
            </value>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="controls_if" id="if_l2">
            <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
            <value name="IF0">
              <block type="contract_check_result" id="chk_l">
                <field name="CHECK_RESULT">win</field>
              </block>
            </value>
            <statement name="DO0">
              <block type="variables_set" id="set_l1">
                <field name="VAR" id="var_stake">stake</field>
                <value name="VALUE">
                  <block type="variables_get" id="g_l6"><field name="VAR" id="var_initial">initial_stake</field></block>
                </value>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="variables_set" id="set_l2">
                <field name="VAR" id="var_stake">stake</field>
                <value name="VALUE">
                  <block type="math_arithmetic" id="mul_l">
                    <field name="OP">MULTIPLY</field>
                    <value name="A">
                      <shadow type="math_number"><field name="NUM">1</field></shadow>
                      <block type="variables_get" id="g_l7"><field name="VAR" id="var_stake">stake</field></block>
                    </value>
                    <value name="B">
                      <shadow type="math_number"><field name="NUM">1</field></shadow>
                      <block type="variables_get" id="g_l8"><field name="VAR" id="var_mult">recovery_multiplier</field></block>
                    </value>
                  </block>
                </value>
              </block>
            </statement>
            <next>
              <block type="trade_again" id="ta_l"></block>
            </next>
          </block>
        </statement>
      </block>
    </statement>
  </block>

  <block type="during_purchase" id="dp_l" deletable="false" x="0" y="1100">
    <statement name="DURING_PURCHASE_STACK"></statement>
  </block>
</xml>
