<xml xmlns="http://www.w3.org/1999/xhtml" is_dbot="true" collection="false">
<variables>
<variable type="" id="var_stake">stake</variable>
<variable type="" id="var_initstake">initialStake</variable>
<variable type="" id="var_mfactor">martingaleFactor</variable>
<variable type="" id="var_tp">takeProfit</variable>
<variable type="" id="var_sl">stopLoss</variable>
<variable type="" id="var_losscount">lossCount</variable>
<variable type="" id="var_maxloss">maxLosses</variable>
</variables>
<block type="trade_definition" id="blk_tradedef" x="0" y="0">
<statement name="TRADE_OPTIONS">
<block type="trade_definition_market" id="tdm" deletable="false" movable="false">
<field name="MARKET_LIST">synthetic_index</field>
<field name="SUBMARKET_LIST">random_index</field>
<field name="SYMBOL_LIST">R_100</field>
<next>
<block type="trade_definition_tradetype" id="tdt" deletable="false" movable="false">
<field name="TRADETYPECAT_LIST">digits</field>
<field name="TRADETYPE_LIST">overunder</field>
<next>
<block type="trade_definition_contracttype" id="tdc" deletable="false" movable="false">
<field name="TYPE_LIST">DIGITOVER</field>
<next>
<block type="trade_definition_candleinterval" id="tdci" deletable="false" movable="false">
<field name="CANDLEINTERVAL_LIST">60</field>
<next>
<block type="trade_definition_restartbuysell" id="tdrb" deletable="false" movable="false">
<field name="TIME_MACHINE_ENABLED">FALSE</field>
<next>
<block type="trade_definition_restartonerror" id="tdre" deletable="false" movable="false">
<field name="RESTARTONERROR">TRUE</field>
</block>
</next>
</block>
</next>
</block>
</next>
</block>
</next>
</block>
</next>
</block>
</statement>
<statement name="INITIALIZATION">
<block type="variables_set" id="init1">
<field name="VAR" id="var_initstake" variabletype="">initialStake</field>
<value name="VALUE">
<block type="math_number" id="n_init1"><field name="NUM">0.5</field></block>
</value>
<next>
<block type="variables_set" id="init2">
<field name="VAR" id="var_stake" variabletype="">stake</field>
<value name="VALUE">
<block type="variables_get" id="g_init2"><field name="VAR" id="var_initstake" variabletype="">initialStake</field></block>
</value>
<next>
<block type="variables_set" id="init3">
<field name="VAR" id="var_mfactor" variabletype="">martingaleFactor</field>
<value name="VALUE">
<block type="math_number" id="n_init3"><field name="NUM">2.1</field></block>
</value>
<next>
<block type="variables_set" id="init4">
<field name="VAR" id="var_tp" variabletype="">takeProfit</field>
<value name="VALUE">
<block type="math_number" id="n_init4"><field name="NUM">10</field></block>
</value>
<next>
<block type="variables_set" id="init5">
<field name="VAR" id="var_sl" variabletype="">stopLoss</field>
<value name="VALUE">
<block type="math_number" id="n_init5"><field name="NUM">-10</field></block>
</value>
<next>
<block type="variables_set" id="init6">
<field name="VAR" id="var_losscount" variabletype="">lossCount</field>
<value name="VALUE">
<block type="math_number" id="n_init6"><field name="NUM">0</field></block>
</value>
<next>
<block type="variables_set" id="init7">
<field name="VAR" id="var_maxloss" variabletype="">maxLosses</field>
<value name="VALUE">
<block type="math_number" id="n_init7"><field name="NUM">5</field></block>
</value>
</block>
</next>
</block>
</next>
</block>
</next>
</block>
</next>
</block>
</next>
</block>
</next>
</block>
</statement>
<statement name="SUBMARKET">
<block type="trade_definition_tradeoptions" id="tdo">
<mutation has_first_barrier="false" has_second_barrier="false" has_prediction="true"></mutation>
<field name="DURATIONTYPE_LIST">t</field>
<value name="DURATION">
<shadow type="math_number" id="sh_dur"><field name="NUM">1</field></shadow>
<block type="math_number" id="blk_dur"><field name="NUM">1</field></block>
</value>
<value name="AMOUNT">
<shadow type="math_number" id="sh_amt"><field name="NUM">1</field></shadow>
<block type="variables_get" id="blk_amt"><field name="VAR" id="var_stake" variabletype="">stake</field></block>
</value>
<value name="PREDICTION">
<shadow type="math_number_positive" id="sh_pred"><field name="NUM">2</field></shadow>
</value>
</block>
</statement>
</block>
<block type="before_purchase" id="blk_beforepurchase" x="0" y="400">
<statement name="BEFOREPURCHASE_STACK">
<block type="purchase" id="blk_purchase">
<field name="PURCHASE_LIST">DIGITOVER</field>
</block>
</statement>
</block>
<block type="after_purchase" id="blk_afterpurchase" x="0" y="700">
<statement name="AFTERPURCHASE_STACK">
<block type="controls_if" id="cif_result">
<mutation else="1"></mutation>
<value name="IF0">
<block type="contract_check_result" id="ccr_win">
<field name="CHECK_RESULT">win</field>
</block>
</value>
<statement name="DO0">
<block type="variables_set" id="set_stake_reset">
<field name="VAR" id="var_stake" variabletype="">stake</field>
<value name="VALUE">
<block type="variables_get" id="g_reset"><field name="VAR" id="var_initstake" variabletype="">initialStake</field></block>
</value>
<next>
<block type="variables_set" id="set_losscount_reset">
<field name="VAR" id="var_losscount" variabletype="">lossCount</field>
<value name="VALUE">
<block type="math_number" id="n_reset"><field name="NUM">0</field></block>
</value>
</block>
</next>
</block>
</statement>
<statement name="ELSE">
<block type="math_change" id="mc_stake">
<field name="VAR" id="var_stake" variabletype="">stake</field>
<value name="DELTA">
<shadow type="math_number" id="sh_mc"><field name="NUM">0</field></shadow>
<block type="math_arithmetic" id="ma_stake">
<field name="OP">MULTIPLY</field>
<value name="A">
<shadow type="math_number" id="sh_ma_a"><field name="NUM">1</field></shadow>
<block type="variables_get" id="g_ma_a"><field name="VAR" id="var_stake" variabletype="">stake</field></block>
</value>
<value name="B">
<shadow type="math_number" id="sh_ma_b"><field name="NUM">1</field></shadow>
<block type="variables_get" id="g_ma_b"><field name="VAR" id="var_mfactor" variabletype="">martingaleFactor</field></block>
</value>
</block>
</value>
<next>
<block type="math_change" id="mc_losscount">
<field name="VAR" id="var_losscount" variabletype="">lossCount</field>
<value name="DELTA">
<shadow type="math_number" id="sh_mc_loss"><field name="NUM">1</field></shadow>
</value>
</block>
</next>
</block>
</statement>
<next>
<block type="controls_if" id="cif_stop">
<mutation else="1"></mutation>
<value name="IF0">
<block type="logic_operation" id="lo_outer">
<field name="OP">OR</field>
<value name="A">
<block type="logic_compare" id="lc_tp">
<field name="OP">GTE</field>
<value name="A">
<block type="total_profit" id="tp_check1"></block>
</value>
<value name="B">
<block type="variables_get" id="g_tp"><field name="VAR" id="var_tp" variabletype="">takeProfit</field></block>
</value>
</block>
</value>
<value name="B">
<block type="logic_operation" id="lo_inner">
<field name="OP">OR</field>
<value name="A">
<block type="logic_compare" id="lc_sl">
<field name="OP">LTE</field>
<value name="A">
<block type="total_profit" id="tp_check2"></block>
</value>
<value name="B">
<block type="variables_get" id="g_sl"><field name="VAR" id="var_sl" variabletype="">stopLoss</field></block>
</value>
</block>
</value>
<value name="B">
<block type="logic_compare" id="lc_maxloss">
<field name="OP">GTE</field>
<value name="A">
<block type="variables_get" id="g_losscount"><field name="VAR" id="var_losscount" variabletype="">lossCount</field></block>
</value>
<value name="B">
<block type="variables_get" id="g_maxloss"><field name="VAR" id="var_maxloss" variabletype="">maxLosses</field></block>
</value>
</block>
</value>
</block>
</value>
</block>
</value>
<statement name="DO0">
<block type="notify" id="nt_stop">
<field name="NOTIFICATION_TYPE">warn</field>
<field name="NOTIFICATION_SOUND">silent</field>
<value name="MESSAGE">
<shadow type="text" id="sh_stopmsg"><field name="TEXT">Bot stopped: target, stop loss, or max loss streak reached.</field></shadow>
</value>
</block>
</statement>
<statement name="ELSE">
<block type="trade_again" id="blk_tradeagain"></block>
</statement>
</block>
</next>
</block>
</statement>
</block>
</xml>
