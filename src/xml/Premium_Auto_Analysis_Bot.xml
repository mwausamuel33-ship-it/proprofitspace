re.</comment><field name="VAR" id="v_INITIAL_STAKE">INITIAL STAKE</field><value name="VALUE"><block type="math_number" id="b741"><field name="NUM">0.5</field></block></value><next><block type="variables_set" id="b1142"><field name="VAR" id="v_STAKE">STAKE</field><value name="VALUE"><block type="variables_get" id="b1141"><field name="VAR" id="v_INITIAL_STAKE">INITIAL STAKE</field></block></value><next><block type="variables_set" id="b1144"><field name="VAR" id="v_TAKE_PROFIT">TAKE PROFIT</field><value name="VALUE"><block type="math_number" id="b742"><field name="NUM">5</field></block></value><next><block type="variables_set" id="b1145"><field name="VAR" id="v_STOP_LOSS">STOP LOSS</field><value name="VALUE"><block type="math_number" id="b743"><field name="NUM">20</field></block></value><next><block type="variables_set" id="b1146"><field name="VAR" id="v_MAX_STAKE">MAX STAKE</field><value name="VALUE"><block type="math_number" id="b744"><field name="NUM">10</field></block></value><next><block type="variables_set" id="b1147"><field name="VAR" id="v_LIMIT_PERCENT">LIMIT PERCENT</field><value name="VALUE"><block type="math_number" id="b745"><field name="NUM">10.5</field></block></value><next><block type="variables_set" id="b1148"><field name="VAR" id="v_MIN_TICKS">MIN TICKS</field><value name="VALUE"><block type="math_number" id="b746"><field name="NUM">10</field></block></value><next><block type="variables_set" id="b1149"><field name="VAR" id="v_PAYOUT_FACTOR">PAYOUT FACTOR</field><value name="VALUE"><block type="math_number" id="b747"><field name="NUM">9.53</field></block></value><next><block type="variables_set" id="b1150"><field name="VAR" id="v_RECOVERY_MARGIN">RECOVERY MARGIN</field><value name="VALUE"><block type="math_number" id="b748"><field name="NUM">1.05</field></block></value><next><block type="variables_set" id="b1151"><field name="VAR" id="v_MAX_RECOVERY">MAX RECOVERY</field><value name="VALUE"><block type="math_number" id="b749"><field name="NUM">3</field>